# Application
APP_ENV=development
# Keep the default for native local use; use 0.0.0.0 inside a forwarded container.
# Publish/forward on the host loopback and browse http://localhost:8080.
APP_LISTEN_HOST=127.0.0.1
APP_PORT=8080
# Console + logs/workstation.log; 10 MiB per file, 3 backups, up to 7 days.
APP_LOG_LEVEL=info
DATABASE_PATH=./data/app.db

# Zoho: use the actual Desk data center; URLs are origins without API paths.
# Credentials must have read access to the configured department.
ZOHO_BASE_URL=
ZOHO_ACCOUNTS_URL=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_DEPARTMENT_ID=

# Jev: full HTTP endpoint; Go maps JEV_API_KEY to Bearer authentication.
# Stable model verified 2026-11-04: https://docs.typesafe.ai/models
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-1.14.0
ENABLE_JEV=true

# Bub SDK: https://bub.build/ ; these values configure its model provider.
# BUB_API_BASE is the provider API base, not https://bub.build/.
# DeepSeek official configuration verified 2026-11-04: https://api-docs.deepseek.com/
BUB_API_BASE=https://api.deepseek.com
BUB_API_KEY=
# Republic model format is provider:model; the upstream alias may change versions.
BUB_MODEL=deepseek:deepseek-flash
ENABLE_BUB=true

# Sampling limits apply across runs/restarts, not separately per interval.
# Run `make run` to start periodic reads; fixed sampling and model request counts persist; request quotas are disabled.
SYNC_INTERVAL=2m
SYNC_LOOKBACK=24h
# Tickets per batch (1..50); concurrent ticket fetches (1..5).
SYNC_BATCH_SIZE=9
SYNC_CONCURRENCY=3

# WeCom automatic notifications are deferred for this release.
ENABLE_WECOM=false
WECOM_WEBHOOK_URL=
